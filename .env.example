# =====================================================================
# 这些变量不要写入前端代码。生产环境请在 Cloudflare Pages 控制台配置：
#   项目 -> Settings -> Environment variables
# 本地用 wrangler pages dev 调试时，请复制为 .dev.vars 并填入真实值（.dev.vars 已被 .gitignore 忽略）。
# =====================================================================

# 飞书自建应用凭证
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书多维表格 App Token（Base URL 中 /base/<这一段>）
FEISHU_BITABLE_APP_TOKEN=xxxxxxxxxxxxxxxxxxxx

# 飞书多维表格 Table ID（表格 URL 中 table=<这一段>）
FEISHU_BITABLE_TABLE_ID=tblxxxxxxxxxxxx

# 可选：字段名覆盖。默认按中文字段名读取，如需自定义可在此指定
# PHOTO_FIELD_IMAGE=图片
# PHOTO_FIELD_TITLE=title
# PHOTO_FIELD_DESC=desc
# PHOTO_FIELD_TIME=photo_time

# 可选：轮询与分页调参
# PHOTO_POLL_SECONDS=30
# PHOTO_PAGE_SIZE=30
# PHOTO_CACHE_TTL=30
